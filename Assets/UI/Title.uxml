<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 타이틀 화면 배경(에디터에서도 보이게). 버튼 클릭 칸·창은 실행하면 TitleScreen이 이 위에 붙인다. -->
    <ui:VisualElement name="title-root" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); overflow: hidden;">
        <ui:VisualElement name="title-art" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: resource(&apos;Title/TitleArt&apos;); background-size: cover;" />
    </ui:VisualElement>
</ui:UXML>
